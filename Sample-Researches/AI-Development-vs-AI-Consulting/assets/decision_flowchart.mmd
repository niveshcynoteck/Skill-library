flowchart TD
    START(["Which path fits you?"]) --> Q1{"Do you have clear requirements and know exactly what to build?"}
    Q1 -- "No: problem is unclear, no strategy yet" --> C["AI CONSULTING: Strategy, roadmap, vendor selection, build-vs-buy, governance"]
    Q1 -- "Yes: requirements are defined" --> Q2{"Is AI a core part of your product?"}
    Q2 -- "Yes" --> D["AI DEVELOPMENT: Architecture, code, models, deployment, maintenance"]
    Q2 -- "No" --> Q3{"What do you need or prefer?"}
    Q3 -- "Guidance and a decision" --> C
    Q3 -- "Working software shipped" --> D
    Q3 -- "Both, in sequence" --> H["HYBRID: Consult first, then build"]
    C --> Q4{"Are you in a regulated industry?"}
    Q4 -- "Yes" --> C
    Q4 -- "No" --> Q3
