flowchart LR
    subgraph Traditional_TDD[Traditional TDD]
        T1[Red: Write failing unit test]
        T2[Green: Make test pass]
        T3[Refactor: Clean code]
        T1 --> T2 --> T3
    end
    
    subgraph AI_TDD[AI-Adapted TDD / EDD]
        A1[Red: Define eval criteria & golden dataset]
        A2[Green: Implement + run evals]
        A3[Refactor: Optimize prompts/models]
        A4[Monitor: Production evals & drift detection]
        A5[Guardrails: Input/Output/Tool validation]
        A1 --> A2 --> A3 --> A4 --> A5
    end
    
    subgraph Key_Differences[Key Differences]
        D1[Deterministic pass/fail → Probabilistic thresholds]
        D2[Unit tests → Eval suites + LLM-as-judge]
        D3[Code versioning → Prompt + model + data versioning]
        D4[Static CI gates → Continuous quality gates + canary]
        D5[Post-deploy monitoring → Real-time guardrails + drift]
    end
    
    style Traditional_TDD fill:#e3f2fd
    style AI_TDD fill:#f3e5f5
    style Key_Differences fill:#fff3e0